{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Notebook": {
      "title": "Notebook",
      "description": "Ledger notebook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "openingBalance": { "type": "integer" },
        "color": { "type": "string", "maxLength": 30 },
        "icon": { "type": "string", "maxLength": 50 },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "openingBalance", "color", "icon", "archived"]
    },
    "Person": {
      "title": "Person",
      "description": "Contact or party in a notebook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "notebookId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "notebookId", "name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A ledger debit or credit entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "notebookId": { "type": "string" },
        "personId": { "type": "string" },
        "type": { "type": "string", "enum": ["gave", "got"] },
        "amount": { "type": "integer" },
        "note": { "type": "string", "maxLength": 500 },
        "occurredAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "notebookId", "personId", "type", "amount", "occurredAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/users/{userId}/notebooks/{notebookId}": {
      "schema": { "$ref": "#/entities/Notebook" },
      "description": "User ledger notebooks"
    },
    "/users/{userId}/people/{personId}": {
      "schema": { "$ref": "#/entities/Person" },
      "description": "Contacts / people belonging to user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transactions belonging to user"
    }
  }
}
