rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all (Pillar 1: Fortress Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().size() >= 4 && data.keys().size() <= 6 &&
        data.id == userId &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotebook(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'openingBalance', 'color', 'icon', 'archived', 'createdAt', 'updatedAt']) &&
        data.keys().size() == 9 &&
        data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.openingBalance is int &&
        data.color is string && data.color.size() <= 30 &&
        data.icon is string && data.icon.size() <= 50 &&
        data.archived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPerson(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'notebookId', 'name', 'createdAt']) &&
        data.keys().size() >= 5 && data.keys().size() <= 6 &&
        data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.notebookId is string && isValidId(data.notebookId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        data.createdAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'notebookId', 'personId', 'type', 'amount', 'occurredAt', 'createdAt']) &&
        data.keys().size() >= 8 && data.keys().size() <= 9 &&
        data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.notebookId is string && isValidId(data.notebookId) &&
        data.personId is string && isValidId(data.personId) &&
        (data.type == 'gave' || data.type == 'got') &&
        data.amount is int && data.amount > 0 &&
        data.occurredAt is int &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    // User document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt', 'email']);
      allow delete: if false;

      // Subcollection: Notebooks
      match /notebooks/{notebookId} {
        allow get: if isOwner(userId) && isValidId(notebookId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notebookId) &&
          incoming().id == notebookId &&
          isValidNotebook(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(notebookId) &&
          isValidNotebook(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'openingBalance', 'color', 'icon', 'archived', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(notebookId);
      }

      // Subcollection: People
      match /people/{personId} {
        allow get: if isOwner(userId) && isValidId(personId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(personId) &&
          incoming().id == personId &&
          isValidPerson(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(personId) &&
          isValidPerson(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone']);
        allow delete: if isOwner(userId) && isValidId(personId);
      }

      // Subcollection: Transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) &&
          incoming().id == transactionId &&
          isValidTransaction(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(transactionId) &&
          isValidTransaction(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'note', 'occurredAt', 'personId', 'notebookId']);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }

    // Home banners (managed from the admin dashboard) - public read, signed-in write.
    match /banners/{bannerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(bannerId) &&
        incoming().id == bannerId &&
        incoming().imageUrl is string && incoming().imageUrl.size() > 0 && incoming().imageUrl.size() <= 2000 &&
        (!('linkUrl' in incoming()) || (incoming().linkUrl is string && incoming().linkUrl.size() <= 2000)) &&
        (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 100)) &&
        (!('order' in incoming()) || incoming().order is int) &&
        (!('active' in incoming()) || incoming().active is bool);
      allow update: if isSignedIn() && isValidId(bannerId) &&
        incoming().id == existing().id &&
        incoming().imageUrl is string && incoming().imageUrl.size() > 0 && incoming().imageUrl.size() <= 2000;
      allow delete: if isSignedIn() && isValidId(bannerId);
    }
  }
}
